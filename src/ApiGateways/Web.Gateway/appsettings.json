{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "MianeIdentityService",
    "Audience": "MianeClients",
    "DurationInMinutes": 30
  },

  "ReverseProxy": {
    "Routes": {
      "auth-public-login-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/login"
        }
      },
      "auth-public-register-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/register"
        }
      },
      "auth-protected-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://identity-api:5127/"
          }
        }
      }
    }
  }
}
