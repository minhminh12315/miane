COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# Mobile app
MOBILE_API_URL=http://localhost:8080
MIANE_AI_IMAGE_URL=http://localhost:8000/api/v1/image/generate-trip-thumbnail

# Google Sign-In. Client ID is public, not a secret.
GOOGLE_CLIENT_ID=135347207127-oido4n87prcqp44lvjtiovfqafr5qkbe.apps.googleusercontent.com
GOOGLE_BYPASS_VALIDATION=false

# Backend security
JWT_SIGNING_KEY=Miane_Development_Jwt_Signing_Key_Change_In_Production_2026!@#

# Database overrides. Leave blank to use Docker Compose defaults.
IDENTITY_DB_CONNECTION_STRING=
TRIP_DB_CONNECTION_STRING=
EXPENSE_DB_CONNECTION_STRING=
NOTIFICATION_DB_CONNECTION_STRING=

# OTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MIANE

# Firebase push notifications
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_WEB_VAPID_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_STORAGE_BUCKET=
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_IOS_CLIENT_ID=

# AI image service
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_FORMAT=jpeg
AI_IMAGE_PUBLIC_BASE_URL=http://localhost:8000
AI_IMAGE_CACHE_DIR=/app/cache

# Optional local landmark selector for AI image prompts.
AI_IMAGE_USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
AI_IMAGE_LANDMARK_MODEL=llama3.2:3b

# Expense/OCR AI service wiring
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# VietQR payment QR generation. Bank list works without these keys, QR generation needs them.
VIETQR_BASE_URL=https://api.vietqr.io/
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
