# MIANE local environment
# Copy this file to .env at the repository root. Never commit .env.
#
# Docker Compose reads this file automatically when commands are run from the
# repository root. Native `flutter run` does NOT read it; pass Flutter values
# with --dart-define as documented in README.md and ENV_KEYS_GUIDE.md.

# -----------------------------------------------------------------------------
# Client URLs
# -----------------------------------------------------------------------------
# These localhost values work for Flutter Web and iOS Simulator on the same Mac.
# For an iPhone, use the development computer's LAN IP.
MOBILE_API_URL=http://localhost:8080
MIANE_AI_IMAGE_URL=http://localhost:8000/api/v1/image/generate-trip-thumbnail

# -----------------------------------------------------------------------------
# Backend security
# -----------------------------------------------------------------------------
# Development fallback only. Generate a unique value for every shared/staging/
# production environment, for example: openssl rand -hex 32
JWT_SIGNING_KEY=Miane_Development_Jwt_Signing_Key_Change_In_Production_2026!@#

# Google ID-token audience checked by Identity.API.
# The native iOS client ID itself is configured in ios/Runner/Info.plist.
GOOGLE_CLIENT_ID=135347207127-oido4n87prcqp44lvjtiovfqafr5qkbe.apps.googleusercontent.com
# DEV ONLY. Keep false unless intentionally testing mock Google tokens.
GOOGLE_BYPASS_VALIDATION=false

# -----------------------------------------------------------------------------
# PostgreSQL overrides
# -----------------------------------------------------------------------------
# Leave blank for the PostgreSQL container declared in docker-compose.yml.
# If using an external server, create all four databases first.
IDENTITY_DB_CONNECTION_STRING=
TRIP_DB_CONNECTION_STRING=
EXPENSE_DB_CONNECTION_STRING=
NOTIFICATION_DB_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# OTP and password-reset email
# -----------------------------------------------------------------------------
# Required for the mobile registration/forgot-password flows.
# For Gmail, SMTP_PASSWORD must be an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MIANE

# -----------------------------------------------------------------------------
# AI destination cover generation
# -----------------------------------------------------------------------------
# OPENAI_API_KEY is required only for "Tạo ảnh bằng AI". Manual cover upload
# and the rest of trip creation still work without it.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FORMAT=jpeg
AI_IMAGE_PUBLIC_BASE_URL=http://localhost:8000
AI_IMAGE_CACHE_DIR=/app/cache

# Optional: let a local Ollama model choose a landmark before image generation.
AI_IMAGE_USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
AI_IMAGE_LANDMARK_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# VietQR
# -----------------------------------------------------------------------------
# Public bank-list lookup works without credentials. QR generation requires
# both VIETQR_CLIENT_ID and VIETQR_API_KEY.
VIETQR_BASE_URL=https://api.vietqr.io/
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# -----------------------------------------------------------------------------
# Reserved integration
# -----------------------------------------------------------------------------
# The .NET AI trip-planner client is registered but no current user-facing
# endpoint calls it, and services/ai-image does not implement /api/planner/suggest.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
